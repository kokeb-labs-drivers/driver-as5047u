 * configure_file() writes it here.
 */
#ifndef AS5047U_VERSION_H
#define AS5047U_VERSION_H

/** Major version: incompatible API changes. */
#define AS5047U_VERSION_MAJOR @AS5047U_VERSION_MAJOR@
/** Minor version: features added compatibly. */
#define AS5047U_VERSION_MINOR @AS5047U_VERSION_MINOR@
/** Patch version: fixes. */
#define AS5047U_VERSION_PATCH @AS5047U_VERSION_PATCH@
/** Full version string, for example "0.1.0". */
#define AS5047U_VERSION_STRING "@AS5047U_VERSION@"

#endif // AS5047U_VERSION_H
